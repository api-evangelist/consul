{
  "opencollection": "1.0.0",
  "info": {
    "name": "HashiCorp Consul HTTP ACL Status API",
    "version": "1.18.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Consul-Token",
      "value": "{{X-Consul-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Status",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Raft leader",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8500/v1/status/leader"
          },
          "docs": "Returns the Raft leader for the datacenter."
        },
        {
          "info": {
            "name": "List Raft peers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8500/v1/status/peers"
          },
          "docs": "Returns the Raft peers for the datacenter."
        }
      ]
    }
  ],
  "bundled": true
}