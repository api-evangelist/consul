{
  "opencollection": "1.0.0",
  "info": {
    "name": "HashiCorp Consul HTTP ACL Events API",
    "version": "1.18.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Consul-Token",
      "value": "{{X-Consul-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fire a new event",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://localhost:8500/v1/event/fire/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "dc",
                "value": "",
                "type": "query",
                "description": "Datacenter to query (defaults to agent's datacenter)"
              },
              {
                "name": "node",
                "value": "",
                "type": "query"
              },
              {
                "name": "service",
                "value": "",
                "type": "query"
              },
              {
                "name": "tag",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Fire a new event"
        },
        {
          "info": {
            "name": "List events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8500/v1/event/list",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "dc",
                "value": "",
                "type": "query",
                "description": "Datacenter to query (defaults to agent's datacenter)"
              }
            ]
          },
          "docs": "List events"
        }
      ]
    }
  ],
  "bundled": true
}